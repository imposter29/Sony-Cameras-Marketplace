PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NODE_ENV=production
CLIENT_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth (optional — sign-in is disabled if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
